{
  "manifest_version": 3,
  "name": "表格导出助手",
  "version": "1.0.0",
  "description": "检测网页表格，一键导出为 CSV 文件。支持多表格选择，纯本地处理，不收集任何数据。",
  "author": "XMLY321",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "downloads"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "表格导出助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
